# Runtime server secrets. In AI Studio, configure these in its Secrets panel
# and ensure the deployed BACKEND receives them. Never use VITE_ for secrets.
GEMINI_API_KEY=""
TRACK123_API_KEY=""

# Required for owner sign-in. Set a new strong password before starting.
OWNER_PASSWORD=""

# Exact public origin, for example https://erp.example.com (optional locally).
APP_URL=""
# Enable when the application is served over HTTPS.
COOKIE_SECURE=false
PORT=3000
# Optional absolute writable JSON data-file path. Run one server per data file.
# DATA_FILE=""
# Optional absolute SQLite accounting database path; parent directory must exist.
# Defaults to DATA_FILE with .accounting.sqlite appended. Requires Node.js 24+.
# ACCOUNTING_DB=""
